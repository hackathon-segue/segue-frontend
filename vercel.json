{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bash scripts/vercel_install_flutter.sh",
  "buildCommand": "bash scripts/vercel_build_flutter_web.sh",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://1.201.116.73/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "http://1.201.116.73/images/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
